# Copy to .env.local (not committed) and restart `npm run dev`.
# In production these are set as build environment variables (see render.yaml).

# Cloudflare Turnstile site key (public). Empty = no CAPTCHA widget.
# Local development: Cloudflare's test key that always passes; 2x00000000000000000000AB
# always fails. Production: the widget's site key from dash.cloudflare.com -> Turnstile.
# Must match TURNSTILE_SECRET_KEY in the backend .env.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Base URL of the API, e.g. https://agaro-coins-api.onrender.com. Leave unset in development:
# the Vite dev server proxies API requests to http://127.0.0.1:8000.
# VITE_API_URL=
