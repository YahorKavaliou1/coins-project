DATABASE_URL=postgresql+asyncpg://coins_user:coins_pass@localhost:5432/coins_db
# Required, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DEFAULT_USER_ROLE=admin

# --- Email (SMTP) ---
# Local development with Mailpit (docker compose up -d, inbox at http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
MAIL_FROM=no-reply@example.com
FRONTEND_URL=http://localhost:5173
# Brevo (real emails): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
# SMTP_USERNAME=<SMTP login>, SMTP_PASSWORD=<SMTP key>, MAIL_FROM=<verified sender address>
# MAIL_FROM_NAME=Coins Catalog

# --- Coin photo storage ---
# local (default): files in app/static/uploads/coins. For the cloud set IMAGE_STORAGE=s3:
# IMAGE_STORAGE=s3
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Only for S3-compatible services (e.g. Cloudflare R2): https://<account>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=
# Public read URL (bucket URL or CDN); empty = https://<bucket>.s3.<region>.amazonaws.com
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=coins
