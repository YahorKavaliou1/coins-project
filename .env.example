DATABASE_URL=postgresql+asyncpg://coins_user:coins_pass@localhost:5432/coins_db
# Log every SQL statement with its parameters (personal data!): local debugging only.
# SQL_ECHO=false
# Required, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DEFAULT_USER_ROLE=user

# --- HTTP ---
# Host names the API answers to (comma-separated). Add your domain in production.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Production: API_DOCS_ENABLED=false; HSTS_ENABLED=true once served over HTTPS.
# API_DOCS_ENABLED=true
# HSTS_ENABLED=false

# --- CAPTCHA (Cloudflare Turnstile) on registration / password reset / resend link ---
# Empty = off. Local development: Cloudflare's test secret, which always passes (use
# 2x0000000000000000000000000000000AA to see it fail). Production: the widget's secret key
# from dash.cloudflare.com -> Turnstile, plus TURNSTILE_HOSTNAME=<your domain>.
# The frontend needs the matching site key: see frontend/.env.example.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_HOSTNAME=

# --- Login protection ---
# Wrong passwords before a temporary lock; the lock doubles on each further failure (max 24 h).
# MAX_FAILED_LOGIN_ATTEMPTS=8
# LOGIN_LOCKOUT_MINUTES=15
# Per-IP request limits. With several workers use shared storage: redis://localhost:6379
# Behind a reverse proxy run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy IP>.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URI=memory://

# --- Email (SMTP) ---
# Local development with Mailpit (docker compose up -d, inbox at http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
MAIL_FROM=no-reply@example.com
FRONTEND_URL=http://localhost:5173
# Brevo (real emails): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
# SMTP_USERNAME=<SMTP login>, SMTP_PASSWORD=<SMTP key>, MAIL_FROM=<verified sender address>
# MAIL_FROM_NAME=Coins Catalog

# --- Coin photo storage ---
# local (default): files in app/static/uploads/coins. For the cloud set IMAGE_STORAGE=s3:
# IMAGE_STORAGE=s3
# S3_BUCKET=
# S3_REGION=eu-central-1   (Cloudflare R2: auto; Google Cloud Storage: e.g. europe-west3)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Only for S3-compatible services (e.g. Cloudflare R2): https://<account>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=
# Public read URL (bucket URL or CDN); empty = https://<bucket>.s3.<region>.amazonaws.com
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=coins
